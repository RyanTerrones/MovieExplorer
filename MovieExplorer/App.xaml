<?xml version="1.0" encoding="UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MovieExplorer.App">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- default theme at startup -->
                <ResourceDictionary Source="Resources/Styles/ThemeDark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource Text}" />
            </Style>

            <Style x:Key="PageBase" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
