<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MovieExplorer.Pages"
    x:Class="MovieExplorer.Pages.MainFlyoutPage"
    FlyoutLayoutBehavior="Popover"
    IsPresented="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{DynamicResource Bg}">

    <FlyoutPage.Flyout>
        <ContentPage
            Title="Menu"
            NavigationPage.HasNavigationBar="False"
            BackgroundColor="{DynamicResource FlyoutBg}">

            <!-- force the flyout menu to be a solid colour -->
            <Grid
                BackgroundColor="{DynamicResource FlyoutBg}"
                WidthRequest="240"
                Padding="16"
                RowDefinitions="Auto,*">

                <Label Text="GitFlix"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource Text}" />

                <VerticalStackLayout Grid.Row="1"
                                     Spacing="12"
                                     Margin="0,18,0,0">

                    <Button Text="Home"
                            Clicked="Home_Clicked"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            HeightRequest="44" />

                    <Button Text="Top 25"
                            Clicked="Top250_Clicked"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            HeightRequest="44" />

                    <Button Text="Settings"
                            Clicked="Settings_Clicked"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            HeightRequest="44" />

                    <Button Text="Login"
                            Clicked="Login_Clicked"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            HeightRequest="44" />

                </VerticalStackLayout>

            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <!-- keep nav bar hidden -->
        <NavigationPage NavigationPage.HasNavigationBar="False">
            <x:Arguments>
                <pages:MoviesPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>