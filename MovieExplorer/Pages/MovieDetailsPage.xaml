<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieExplorer.Pages.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Movie Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- poster -->
            <Border HeightRequest="260"
                    StrokeThickness="0"
                    BackgroundColor="Black">
                <Image x:Name="PosterImage"
                       Aspect="AspectFill" />
            </Border>

            <!-- title and year -->
            <Grid ColumnDefinitions="*,Auto,Auto" VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       Grid.Column="0"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#E7EAF0"
                       LineBreakMode="TailTruncation" />

                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        Padding="6"
                        Margin="12,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FavouriteButton_Tapped"/>
                    </Border.GestureRecognizers>

                    <Path x:Name="FavouriteStar"
                      Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.45 13.97L5.82 21Z"
                      Stroke="#A0A7B5"
                      StrokeThickness="2"
                      Fill="Transparent"
                      WidthRequest="24"
                      HeightRequest="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        Padding="6"
                        Margin="8,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Watchlist_Tapped"/>
                    </Border.GestureRecognizers>

                    <Path x:Name="WatchlistIcon"
                          Data="M6 2H18A2 2 0 0 1 20 4V22L12 18L4 22V4A2 2 0 0 1 6 2Z"
                          Stroke="#A0A7B5"
                          StrokeThickness="2"
                          Fill="Transparent"
                          WidthRequest="22"
                          HeightRequest="22"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
                </Border>
                
            </Grid>

            <Label x:Name="YearLabel"
                   FontSize="16"
                   TextColor="Gray" />

            <!-- extra info -->
            <Label x:Name="GenresLabel"
                   FontSize="14"
                   TextColor="Gray" />

            <Label x:Name="DirectorLabel"
                   FontSize="14"
                   TextColor="Gray" />

            <Label x:Name="RatingLabel"
                   FontSize="16"
                   FontAttributes="Bold" />

            <!-- plot text is bound, no x:Name -->
            <Label FontSize="14"
                   Text="{Binding Plot}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>