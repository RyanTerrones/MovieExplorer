<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieExplorer.Pages.WatchlistPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0F1115"
    Title="Watchlist">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Clear" Clicked="ClearWatchlist_Clicked" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="WatchlistView"
                    SelectionMode="Single"
                    SelectionChanged="WatchlistView_SelectionChanged"
                    Margin="16,12">

        <CollectionView.EmptyView>
            <VerticalStackLayout Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="No watchlist items yet"
                       TextColor="#E7EAF0"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalTextAlignment="Center" />

                <Label Text="Tap the bookmark on a movie to save it here."
                       TextColor="#A0A7B5"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem Text="Remove"
                                       BackgroundColor="#202533"
                                       Invoked="RemoveWatchlist_Invoked"
                                       CommandParameter="{Binding ImdbId}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border BackgroundColor="#181B22"
                            Stroke="#202533"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="70,*" ColumnSpacing="12">
                            <Image Source="{Binding PosterSafe}"
                                   WidthRequest="70"
                                   HeightRequest="100"
                                   Aspect="AspectFill" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       TextColor="#E7EAF0"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Year}"
                                       TextColor="#A0A7B5"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </SwipeView>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>