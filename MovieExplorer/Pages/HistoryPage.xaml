<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieExplorer.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="History"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{DynamicResource Bg}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <!-- top bar  -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
            <Button Text="?"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="Back_Clicked"
                    BackgroundColor="{DynamicResource CardBg}"
                    TextColor="{DynamicResource Text}" />

            <Button Grid.Column="1"
                    Text="?"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="Menu_Clicked"
                    BackgroundColor="{DynamicResource CardBg}"
                    TextColor="{DynamicResource Text}" />

            <Label Grid.Column="2"
                   Text="History"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource Text}" />

            <Button Grid.Column="3"
                    Text="Clear"
                    Clicked="ClearHistory_Clicked"
                    BackgroundColor="{DynamicResource CardBg}"
                    TextColor="{DynamicResource Text}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        x:Name="HistoryView"
                        SelectionMode="Single"
                        SelectionChanged="HistoryView_SelectionChanged">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No history yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource Text}" />
                    <Label Text="Open a movie to start tracking it here."
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource SubText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Remove"
                                           BackgroundColor="#702D33"
                                           Invoked="RemoveHistory_Invoked"
                                           CommandParameter="{Binding ImdbId}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                Padding="10"
                                Margin="0,0,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                <Image Source="{Binding PosterSafe}"
                                       WidthRequest="78"
                                       HeightRequest="100"
                                       Aspect="AspectFill" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{DynamicResource Text}" />
                                    <Label Text="{Binding Year}"
                                           FontSize="12"
                                           TextColor="{DynamicResource SubText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>