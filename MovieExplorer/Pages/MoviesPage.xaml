<ContentPage
    x:Class="MovieExplorer.Pages.MoviesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0F1115"
    Title="GitFlix">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="14">

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                BackgroundColor="#181B22"
                Stroke="#202533"
                StrokeThickness="1"
                Padding="14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                <!-- Menu (placeholder for later) -->
                <Button Text="☰"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="#E7EAF0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="12"
                        Padding="0" />

                <!-- Logo + Search -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Image Source="gitflix_logo.png"
                           HeightRequest="34"
                           WidthRequest="34"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>

                    <!-- Green accent search pill -->
                    <Border Grid.Column="1"
                            BackgroundColor="#0F1115"
                            Stroke="#26D07C"
                            StrokeThickness="2"
                            Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <!-- IMPORTANT: name + events match your code-behind -->
                        <SearchBar x:Name="TitleSearchBar"
                                   Placeholder="Search movies..."
                                   PlaceholderColor="#A0A7B5"
                                   TextColor="#E7EAF0"
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="#26D07C"
                                   TextChanged="TitleSearchBar_TextChanged"
                                   SearchButtonPressed="TitleSearchBar_SearchButtonPressed" />
                    </Border>
                </Grid>

                <!-- Right buttons (placeholders: Top250 / Watchlist / Sign in later) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Button Text="★"
                            BackgroundColor="#202533"
                            TextColor="#E7EAF0"
                            WidthRequest="44" HeightRequest="44"
                            CornerRadius="12"
                            Padding="0"/>

                    <Button Text="⏱"
                            BackgroundColor="#202533"
                            TextColor="#E7EAF0"
                            WidthRequest="44" HeightRequest="44"
                            CornerRadius="12"
                            Padding="0"/>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- welcome text -->
        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Label Text="Welcome to"
                   FontSize="16"
                   TextColor="#A0A7B5"/>
            <Label Text="GitFlix"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#E7EAF0"/>
        </VerticalStackLayout>

        <!-- MOVIE POSTERS GRID -->
        <CollectionView Grid.Row="2"
                        x:Name="MoviesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="MoviesCollectionView_SelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="MoviesGridLayout"
                     Orientation="Vertical"
                     Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#181B22"
                            Stroke="#202533"
                            StrokeThickness="1"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="180,Auto">
                            <!-- Poster -->
                            <Image Source="{Binding PosterSafe}"
                                   Aspect="AspectFill"
                                   HeightRequest="180" />

                            <!-- Title/Year -->
                            <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="#E7EAF0"/>
                                <Label Text="{Binding Year}"
                                       FontSize="12"
                                       TextColor="#A0A7B5"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>