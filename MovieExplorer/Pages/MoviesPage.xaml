<ContentPage
    x:Class="MovieExplorer.Pages.MoviesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="GitFlix"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="16">

        <!-- top bar -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource CardStroke}"
                StrokeThickness="1"
                Padding="14"
                StrokeShape="RoundRectangle 22">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                <!-- menu -->
                <Button Text="☰"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Text}"
                        Clicked="Hamburger_Clicked"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0" />

                <!-- logo -->
                <Image Grid.Column="1"
                       Source="gitflix_logo.png"
                       HeightRequest="34"
                       WidthRequest="34"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />

                <!-- search -->
                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="{DynamicResource AccentGreen}"
                        StrokeThickness="2"
                        Padding="12,6"
                        StrokeShape="RoundRectangle 16">

                    <SearchBar x:Name="TitleSearchBar"
                               Placeholder="Search movies..."
                               TextColor="{DynamicResource Text}"
                               PlaceholderColor="{DynamicResource SubText}"
                               BackgroundColor="Transparent"
                               TextChanged="TitleSearchBar_TextChanged"
                               SearchButtonPressed="TitleSearchBar_SearchButtonPressed" />
                </Border>

                <!-- right icons -->
                <HorizontalStackLayout Grid.Column="3" Spacing="10" VerticalOptions="Center">

                    <Button Text="★"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            WidthRequest="44"
                            HeightRequest="44"
                            Clicked="Favourites_Clicked" />

                    <Button Text="🔖"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            WidthRequest="44"
                            HeightRequest="44"
                            Clicked="Watchlist_Clicked" />

                    <Button Text="🕘"
                            BackgroundColor="{DynamicResource CardBg}"
                            TextColor="{DynamicResource Text}"
                            CornerRadius="12"
                            WidthRequest="44"
                            HeightRequest="44"
                            Clicked="History_Clicked" />

                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- welcome text -->
        <VerticalStackLayout Grid.Row="1" Spacing="4" HorizontalOptions="Center">
            <Label Text="Welcome to"
                   FontSize="16"
                   TextColor="{DynamicResource SubText}"
                   HorizontalTextAlignment="Center" />

            <Label Text="GitFlix"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Text}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- movies grid -->
        <CollectionView Grid.Row="2"
                        x:Name="MoviesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="MoviesCollectionView_SelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="MoviesGridLayout"
                                 Orientation="Vertical"
                                 Span="4"
                                 HorizontalItemSpacing="14"
                                 VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="0">

                        <Grid RowDefinitions="160,Auto" WidthRequest="190">

                            <Image Grid.Row="0"
                                   Source="{Binding PosterSafe}"
                                   Aspect="AspectFill"
                                   HeightRequest="160" />

                            <VerticalStackLayout Grid.Row="1" Padding="10" Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Text}"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Year}"
                                       FontSize="12"
                                       TextColor="{DynamicResource SubText}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>